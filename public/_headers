# ==============================================================================
# Cloudflare Pages Security & Cache Headers
# ==============================================================================

# ── Hashed JS/CSS/Font Assets (Vite content-hash in filename) ─────────────────
# Safe to cache for 1 year — Vite's [hash] guarantees cache-busting on deploy.
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

/assets/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/assets/*.woff
  Cache-Control: public, max-age=31536000, immutable

/assets/*.png
  Cache-Control: public, max-age=31536000, immutable

/assets/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/assets/*.webp
  Cache-Control: public, max-age=31536000, immutable

/assets/*.svg
  Cache-Control: public, max-age=31536000, immutable

# ── Favicons (7 day cache) ─────────────────────────────────────────────────────
/favicon.*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# ── HTML (always revalidate to pick up new deploys immediately) ───────────────
/
  Cache-Control: no-cache, must-revalidate

/*.html
  Cache-Control: no-cache, must-revalidate

# ── API routes (never cache) ──────────────────────────────────────────────────
/api/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/*
  # 1. HTTP Strict Transport Security (HSTS)
  # Forces all future connections over HTTPS for 1 year, including subdomains.
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # 2. Clickjacking Protection
  # Prevents framing of this site inside external iframes.
  X-Frame-Options: DENY

  # 3. MIME-Sniffing Prevention
  # Disables MIME type sniffing by the browser.
  X-Content-Type-Options: nosniff

  # 4. Referrer Policy
  # Sends full referrer to same origin, but only origin over cross-origin HTTPS.
  Referrer-Policy: strict-origin-when-cross-origin

  # 5. Cross-Site Scripting (XSS) Legacy Protection
  X-XSS-Protection: 1; mode=block

  # 6. Browser Permissions / Feature Policy
  # Restricts browser hardware access.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self "https://*.cashfree.com")

  # 7. Content Security Policy (CSP)
  # Tailored specifically for Xylem Learning:
  # - Google Tag Manager (GTM) & Analytics
  # - Meta Pixel (Facebook)
  # - Cashfree Payments SDK & Payment Frames
  # - Remote Image CDN
  # - Google Fonts Typography
  # - Unsplash Avatars
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://connect.facebook.net https://www.googletagmanager.com https://*.googletagmanager.com https://*.google-analytics.com https://sdk.cashfree.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://www.facebook.com https://www.googletagmanager.com https://*.google-analytics.com https://*.googletagmanager.com https://res.cloudinary.com https://images.unsplash.com https://*.cashfree.com; connect-src 'self' https://connect.facebook.net https://www.facebook.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://sandbox.cashfree.com https://api.cashfree.com https://*.cashfree.com https://fonts.googleapis.com https://cloudflareinsights.com; frame-src 'self' https://www.googletagmanager.com https://sandbox.cashfree.com https://api.cashfree.com https://*.cashfree.com; base-uri 'self'; form-action 'self' https://sandbox.cashfree.com https://api.cashfree.com https://*.cashfree.com; object-src 'none';
