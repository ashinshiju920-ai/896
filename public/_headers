# ==============================================================================
# Cloudflare Pages Security & Cache Headers
# ==============================================================================

/api/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/*
  # 1. HTTP Strict Transport Security (HSTS)
  # Forces all future connections over HTTPS for 1 year, including subdomains.
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # 2. Clickjacking Protection
  # Prevents framing of this site inside external iframes.
  X-Frame-Options: DENY

  # 3. MIME-Sniffing Prevention
  # Disables MIME type sniffing by the browser.
  X-Content-Type-Options: nosniff

  # 4. Referrer Policy
  # Sends full referrer to same origin, but only origin over cross-origin HTTPS.
  Referrer-Policy: strict-origin-when-cross-origin

  # 5. Cross-Site Scripting (XSS) Legacy Protection
  X-XSS-Protection: 1; mode=block

  # 6. Browser Permissions / Feature Policy
  # Restricts browser hardware access.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self "https://*.cashfree.com")

  # 7. Content Security Policy (CSP)
  # Tailored specifically for Xylem Learning:
  # - Cashfree Payments SDK & Payment Frames
  # - Remote Image CDN
  # - Google Fonts Typography
  # - Unsplash Avatars
  Content-Security-Policy: default-src 'self'; script-src 'self' https://sdk.cashfree.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://res.cloudinary.com https://images.unsplash.com https://*.cashfree.com; connect-src 'self' https://sandbox.cashfree.com https://api.cashfree.com https://*.cashfree.com https://fonts.googleapis.com; frame-src 'self' https://sandbox.cashfree.com https://api.cashfree.com https://*.cashfree.com; base-uri 'self'; form-action 'self' https://sandbox.cashfree.com https://api.cashfree.com https://*.cashfree.com; object-src 'none';
