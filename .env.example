# ==============================================================================
# XYLEM LEARNING - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# NOTE: In Cloudflare Pages, configure these under:
# Project Settings > Environment variables (for both Production and Preview).
# NEVER commit real credentials, keys, or secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CASHFREE PAYMENT GATEWAY (PG v3)
# ------------------------------------------------------------------------------
# CASHFREE_APP_ID: Your Cashfree Client/App ID (e.g. CF123456...)
CASHFREE_APP_ID=

# CASHFREE_SECRET_KEY: Your Cashfree Secret Key (e.g. cfsk_ma_...)
CASHFREE_SECRET_KEY=

# CASHFREE_ENV: "PRODUCTION" or "SANDBOX"
CASHFREE_ENV=PRODUCTION

# CASHFREE_BASE_URL: Optional API endpoint override
# Default Production: https://api.cashfree.com/pg/orders
# Default Sandbox:    https://sandbox.cashfree.com/pg/orders
CASHFREE_BASE_URL=

# ------------------------------------------------------------------------------
# 2. CLOUDINARY MEDIA & CATALOGUE STORAGE
# ------------------------------------------------------------------------------
# CLOUDINARY_CLOUD_NAME: Cloudinary cloud account name
CLOUDINARY_CLOUD_NAME=

# CLOUDINARY_API_KEY: Cloudinary API key
CLOUDINARY_API_KEY=

# CLOUDINARY_API_SECRET: Cloudinary API secret
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 3. ADMIN AUTHENTICATION (PBKDF2 & HMAC-SHA256)
# ------------------------------------------------------------------------------
# ADMIN_PASSWORD_HASH: 64-character hex string from PBKDF2-SHA256 (100,000 iters)
# Generate with: node -e "const crypto=require('crypto'); const salt=crypto.randomBytes(16).toString('hex'); console.log('SALT:', salt); console.log('HASH:', crypto.pbkdf2Sync('YOUR_PASSWORD', salt, 100000, 32, 'sha256').toString('hex'));"
ADMIN_PASSWORD_HASH=

# ADMIN_PASSWORD_SALT: 32+ character hex string salt paired with ADMIN_PASSWORD_HASH
ADMIN_PASSWORD_SALT=

# ADMIN_SESSION_SECRET: High-entropy random hex or base64 string for signing session cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'));"
ADMIN_SESSION_SECRET=

# ------------------------------------------------------------------------------
# 4. CORS & DOMAIN POLICIES (OPTIONAL)
# ------------------------------------------------------------------------------
# ALLOWED_ORIGIN: Override or add an additional trusted origin (e.g. https://custom.domain.com)
ALLOWED_ORIGIN=

# ==============================================================================
# CLOUDFLARE PAGES BINDINGS (Configure in CF Pages > Settings > Functions)
# ==============================================================================
# 1. KV Namespace Binding:
#    - Variable name: PRODUCTS_KV
#    - Purpose: Catalogue storage, fast edge caching, sliding-window rate limiting
#
# 2. D1 Database Binding:
#    - Variable name: DB
#    - Purpose: Persistent orders, payment audit trails, and event logs
# ==============================================================================
